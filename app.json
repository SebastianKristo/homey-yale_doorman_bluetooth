{
  "id": "no.kristo.yaleble",
  "version": "2.1.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Yale Local Bluetooth",
    "no": "Yale lokal Bluetooth"
  },
  "description": {
    "en": "Control Yale Doorman L3 and other Yale/August locks directly over Bluetooth, without the cloud.",
    "no": "Styr Yale Doorman L3 og andre Yale/August-låser direkte over Bluetooth, uten sky."
  },
  "category": [
    "security"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "brandColor": "#1E3A5F",
  "author": {
    "name": "Sebastian Kristo",
    "email": "sebastian@kristo.no"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "lock_state": {
      "type": "enum",
      "title": {
        "en": "Lock state",
        "no": "Låsstatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/lock_state.svg",
      "values": [
        {
          "id": "unknown",
          "title": {
            "en": "Unknown",
            "no": "Ukjent"
          }
        },
        {
          "id": "calibrating",
          "title": {
            "en": "Calibrating",
            "no": "Kalibrerer"
          }
        },
        {
          "id": "unlocking",
          "title": {
            "en": "Unlocking",
            "no": "Låser opp"
          }
        },
        {
          "id": "unlocked",
          "title": {
            "en": "Unlocked",
            "no": "Ulåst"
          }
        },
        {
          "id": "locking",
          "title": {
            "en": "Locking",
            "no": "Låser"
          }
        },
        {
          "id": "locked",
          "title": {
            "en": "Locked",
            "no": "Låst"
          }
        },
        {
          "id": "jammed",
          "title": {
            "en": "Jammed",
            "no": "Fastkjørt"
          }
        }
      ]
    }
  },
  "flow": {
    "actions": [
      {
        "id": "refresh_status",
        "title": {
          "en": "Refresh lock status",
          "no": "Oppdater låsstatus"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "local_failed",
        "title": {
          "en": "Local control failed",
          "no": "Lokal styring feilet"
        },
        "hint": {
          "en": "Lock/unlock over Bluetooth didn't reach the lock. Use it to fall back to e.g. the Yale Home (cloud) app.",
          "no": "Lås/lås opp over Bluetooth nådde ikke frem. Bruk den til å gå via f.eks. Yale Home-appen (sky)."
        },
        "tokens": [
          {
            "name": "action",
            "type": "string",
            "title": {
              "en": "Action",
              "no": "Handling"
            },
            "example": {
              "en": "lock",
              "no": "lock"
            }
          },
          {
            "name": "error",
            "type": "string",
            "title": {
              "en": "Error",
              "no": "Feil"
            },
            "example": {
              "en": "Timeout",
              "no": "Timeout"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          }
        ]
      },
      {
        "id": "unifi_event",
        "title": {
          "en": "UniFi event received",
          "no": "UniFi-hendelse mottatt"
        },
        "hint": {
          "en": "A webhook from UniFi Alarm Manager / UniFi Access, e.g. face recognition or fingerprint. Check the person in the Flow before unlocking.",
          "no": "En webhook fra UniFi Alarm Manager / UniFi Access, f.eks. ansiktsgjenkjenning eller fingeravtrykk. Sjekk personen i Flowen før du låser opp."
        },
        "tokens": [
          {
            "name": "person",
            "type": "string",
            "title": {
              "en": "Person",
              "no": "Person"
            },
            "example": {
              "en": "Sebastian",
              "no": "Sebastian"
            }
          },
          {
            "name": "type",
            "type": "string",
            "title": {
              "en": "Type",
              "no": "Type"
            },
            "example": {
              "en": "face",
              "no": "face"
            }
          },
          {
            "name": "result",
            "type": "string",
            "title": {
              "en": "Result",
              "no": "Resultat"
            },
            "example": {
              "en": "ACCESS",
              "no": "ACCESS"
            }
          },
          {
            "name": "alarm",
            "type": "string",
            "title": {
              "en": "Alarm name",
              "no": "Alarmnavn"
            },
            "example": {
              "en": "Front door face",
              "no": "Inngang ansikt"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device",
              "no": "Enhet"
            },
            "example": {
              "en": "G4 Doorbell",
              "no": "G4 Doorbell"
            }
          },
          {
            "name": "rawType",
            "type": "string",
            "title": {
              "en": "Raw trigger",
              "no": "Rå trigger"
            },
            "example": {
              "en": "face_known",
              "no": "face_known"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_reachable",
        "title": {
          "en": "Lock !{{is|isn't}} reachable locally",
          "no": "Låsen !{{er|er ikke}} tilgjengelig lokalt"
        },
        "hint": {
          "en": "Whether the last Bluetooth contact with the lock succeeded.",
          "no": "Om siste Bluetooth-kontakt med låsen lyktes."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=lock"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "lock",
      "name": {
        "en": "Yale lock (Bluetooth)",
        "no": "Yale-lås (Bluetooth)"
      },
      "class": "lock",
      "capabilities": [
        "locked",
        "lock_state",
        "measure_battery",
        "alarm_battery"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble"
      ],
      "images": {
        "small": "/drivers/lock/assets/images/small.png",
        "large": "/drivers/lock/assets/images/large.png",
        "xlarge": "/drivers/lock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "credentials",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Offline key",
            "no": "Offline-nøkkel"
          },
          "children": [
            {
              "id": "offline_key",
              "type": "password",
              "label": {
                "en": "Offline key (32 hex chars)",
                "no": "Offline-nøkkel (32 hex-tegn)"
              },
              "value": "",
              "hint": {
                "en": "From Home Assistant (Terminal & SSH add-on): jq '.data.entries[] | select(.domain==\"yalexs_ble\") | {key: .data.key, slot: .data.slot}' /config/.storage/core.config_entries",
                "no": "Fra Home Assistant (tillegget Terminal & SSH): jq '.data.entries[] | select(.domain==\"yalexs_ble\") | {key: .data.key, slot: .data.slot}' /config/.storage/core.config_entries"
              }
            },
            {
              "id": "offline_slot",
              "type": "number",
              "label": {
                "en": "Key slot",
                "no": "Nøkkel-slot"
              },
              "value": 1,
              "min": 0,
              "max": 255
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "ESPHome Bluetooth proxy (optional)",
            "no": "ESPHome Bluetooth-proxy (valgfritt)"
          },
          "children": [
            {
              "id": "proxy_host",
              "type": "text",
              "value": "",
              "label": {
                "en": "Proxy IP address",
                "no": "Proxy IP-adresse"
              },
              "hint": {
                "en": "IP of an ESPHome device with bluetooth_proxy (e.g. Everything Presence One) near the lock. Leave empty to use Homey's own Bluetooth.",
                "no": "IP til en ESPHome-enhet med bluetooth_proxy (f.eks. Everything Presence One) nær låsen. La stå tomt for å bruke Homeys egen Bluetooth."
              }
            },
            {
              "id": "proxy_key",
              "type": "password",
              "value": "",
              "label": {
                "en": "Proxy encryption key",
                "no": "Proxy krypteringsnøkkel"
              },
              "hint": {
                "en": "The api encryption key from ESPHome. In Home Assistant: jq '.data.entries[] | select(.domain==\"esphome\") | {title, host: .data.host, key: .data.noise_psk}' /config/.storage/core.config_entries",
                "no": "api-krypteringsnøkkelen fra ESPHome. I Home Assistant: jq '.data.entries[] | select(.domain==\"esphome\") | {title, host: .data.host, key: .data.noise_psk}' /config/.storage/core.config_entries"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Status updates",
            "no": "Statusoppdatering"
          },
          "children": [
            {
              "id": "always_connected",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Always connected",
                "no": "Alltid tilkoblet"
              },
              "hint": {
                "en": "Keep the Bluetooth connection open, like Home Assistant's \"Always connected\". Much faster lock/unlock and instant state updates, but uses more of the lock's battery.",
                "no": "Hold Bluetooth-forbindelsen åpen, som «Always connected» i Home Assistant. Mye raskere lås/lås opp og umiddelbar status, men bruker mer av låsens batteri."
              }
            },
            {
              "id": "scan_interval",
              "type": "number",
              "label": {
                "en": "Bluetooth scan interval",
                "no": "Bluetooth-skanneintervall"
              },
              "hint": {
                "en": "Passive check for state changes. 0 = off.",
                "no": "Passiv sjekk etter endringer. 0 = av."
              },
              "value": 30,
              "min": 0,
              "max": 3600,
              "units": {
                "en": "s"
              }
            },
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Full poll interval",
                "no": "Full avlesning, intervall"
              },
              "hint": {
                "en": "Connects to the lock (uses battery). 0 = off.",
                "no": "Kobler til låsen (bruker batteri). 0 = av."
              },
              "value": 60,
              "min": 0,
              "max": 1440,
              "units": {
                "en": "min"
              }
            },
            {
              "id": "battery_alarm",
              "type": "number",
              "label": {
                "en": "Low battery alarm below",
                "no": "Lavt batteri-alarm under"
              },
              "value": 20,
              "min": 0,
              "max": 100,
              "units": {
                "en": "%"
              }
            }
          ]
        }
      ],
      "energy": {
        "batteries": [
          "AA",
          "AA",
          "AA",
          "AA"
        ]
      }
    }
  ],
  "source": "https://github.com/SebastianKristo/homey-yale_doorman_bluetooth",
  "bugs": {
    "url": "https://github.com/SebastianKristo/homey-yale_doorman_bluetooth/issues"
  },
  "api": {
    "unifiPost": {
      "method": "POST",
      "path": "/unifi",
      "public": true
    },
    "unifiGet": {
      "method": "GET",
      "path": "/unifi",
      "public": true
    },
    "webhookInfo": {
      "method": "GET",
      "path": "/webhook-info"
    },
    "regenerateToken": {
      "method": "POST",
      "path": "/webhook-token"
    }
  }
}